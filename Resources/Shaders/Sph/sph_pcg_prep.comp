#version 450
// PCG, step 0: first guess x0 of the density pressure (s = p / rho^2) from the previous sub-step.
//   active particle   : x0 = warmFactor * max(previous pressure, 0)
//   inactive particle : x0 = 0 (free surface: incomplete neighborhood, or degenerate DFSPH factor)
// x lives in warm[] (persistent, reordered by the cell sort). Inactive particles always keep x = r = p = 0,
// so the other PCG kernels never need to test the mask of the neighbors.
layout(local_size_x = 256) in;

layout(std140, set = 0, binding = 0) uniform Params {
    vec4 boxMin; vec4 boxMax; vec4 bLo; vec4 gravity;
    ivec4 gridDim;
    ivec4 bGridDim;
    uint numFluid; uint numBoundary; uint maxNeighbors; uint minNbrDiv;
    float h; float h2; float invH; float kernelK;
    float kernelL; float W0; float mass; float sFull;
    float invCell; float restDensity; float viscCoef; float viscEps;
    float wallDamping; float surfaceNbrThreshold; float pcgRegularization; float pad;
    vec4 cyl;
} P;

struct Particle { vec4 pd; vec4 vi; };
layout(std430, set = 0, binding = 1)  buffer Particles { Particle particles[]; };
layout(std430, set = 0, binding = 3)  buffer Meta { uvec4 meta[]; };            // z = nbrTotal
layout(std430, set = 0, binding = 14) buffer Warm { float warmBuf[]; };

layout(push_constant) uniform PC {
    float dt; float tol; uint divergence; uint minIt; uint maxIt;
    uint flags;         // bit 0 = surface mask enabled
    uint mode;
    float warmFactor;
} pc;

bool bad(float x)
{
    return (floatBitsToUint(x) & 0x7F800000u) == 0x7F800000u;
}

bool isActive(uint i)
{
    if (particles[i].vi.w <= 0.0)
        return false;
    if ((pc.flags & 1u) != 0u && float(meta[i].z) < P.surfaceNbrThreshold)
        return false;
    return true;
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= P.numFluid)
        return;

    float w = warmBuf[i];
    if (bad(w))
        w = 0.0;
    warmBuf[i] = isActive(i) ? pc.warmFactor * max(w, 0.0) : 0.0;
}
