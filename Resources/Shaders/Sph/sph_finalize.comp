#version 450
// End of a sub-step: sanitize the velocities left by the divergence solver and compute the max speed
// (work group reduction + atomicMax on the float bits, valid because speeds are >= 0).
// The CPU reads stats[0] a few frames later to choose the time step (CFL).
layout(local_size_x = 256) in;

layout(std140, set = 0, binding = 0) uniform Params {
    vec4 boxMin; vec4 boxMax; vec4 bLo; vec4 gravity;
    ivec4 gridDim;
    ivec4 bGridDim;
    uint numFluid; uint numBoundary; uint maxNeighbors; uint minNbrDiv;
    float h; float h2; float invH; float kernelK;
    float kernelL; float W0; float mass; float sFull;
    float invCell; float restDensity; float viscCoef; float viscEps;
    float wallDamping; float surfaceNbrThreshold; float pcgRegularization; float pad;
    vec4 cyl;
} P;

struct Particle { vec4 pd; vec4 vi; };
layout(std430, set = 0, binding = 1)  buffer Particles { Particle particles[]; };
layout(std430, set = 0, binding = 13) buffer Stats { uint stats[]; };

shared vec2 sMax[256];

bool bad(float x)
{
    return (floatBitsToUint(x) & 0x7F800000u) == 0x7F800000u;
}

void main()
{
    uint i   = gl_GlobalInvocationID.x;
    uint lid = gl_LocalInvocationID.x;
    float sp   = 0.0;
    float comp = 0.0;

    if (i < P.numFluid)
    {
        vec3  v = particles[i].vi.xyz;
        float s = length(v);
        if (bad(s))
        {
            v = vec3(0.0);
            s = 0.0;
        }
        else if (s > P.gravity.w)
        {
            v *= P.gravity.w / s;
            s = P.gravity.w;
        }
        particles[i].vi.xyz = v;
        sp = s;

        // Volume compression: relative density excess (rho is up to date, the divergence solver does not move particles)
        comp = max((particles[i].pd.w - P.restDensity) / P.restDensity, 0.0);
        if (bad(comp))
            comp = 0.0;
    }

    sMax[lid] = vec2(sp, comp);
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u)
    {
        if (lid < stride)
            sMax[lid] = max(sMax[lid], sMax[lid + stride]);
        barrier();
    }
    if (lid == 0u)
    {
        atomicMax(stats[0], floatBitsToUint(sMax[0].x));    // max speed
        atomicMax(stats[3], floatBitsToUint(sMax[0].y));    // max compression (>= 0, so the float bits are ordered)
    }
}