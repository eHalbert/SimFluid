#version 450
// DFSPH solver, pass 1 of an iteration: error and s_i = p_i / rho_i^2 of every particle.
//   density solver    (divergence == 0): predicted density rho + dt * d rho/dt must reach restDensity
//   divergence solver (divergence == 1): d rho/dt must reach 0 (only particles with a nearly full neighborhood)
// Reads the velocities (neighbors included), writes its own s. The error sum of each work group goes to partials[].
layout(local_size_x = 256) in;

layout(std140, set = 0, binding = 0) uniform Params {
    vec4 boxMin; vec4 boxMax; vec4 bLo; vec4 gravity;
    ivec4 gridDim;
    ivec4 bGridDim;
    uint numFluid; uint numBoundary; uint maxNeighbors; uint minNbrDiv;
    float h; float h2; float invH; float kernelK;
    float kernelL; float W0; float mass; float sFull;
    float invCell; float restDensity; float viscCoef; float viscEps;
    float wallDamping; float surfaceNbrThreshold; float pcgRegularization; float pad;
    vec4 cyl;
} P;

struct Particle { vec4 pd; vec4 vi; };
layout(std430, set = 0, binding = 1)  buffer Particles { Particle particles[]; };
layout(std430, set = 0, binding = 3)  buffer Meta { uvec4 meta[]; };            // z = nbrTotal, w = nbrCount
layout(std430, set = 0, binding = 5)  buffer NbrIdx { uint nbrIdx[]; };
layout(std430, set = 0, binding = 6)  buffer NbrGrad { float nbrGrad[]; };
layout(std430, set = 0, binding = 10) buffer SolS { float solS[]; };
layout(std430, set = 0, binding = 11) buffer Partials { float partials[]; };

layout(push_constant) uniform PC {
    float dt; float tol; uint divergence; uint minIt; uint maxIt; uint first; uint pad0; uint pad1;
    vec4 curPos; vec4 curVel;       // force cursor (unused here)
    vec4 piston;                    // x = face position (m), y = velocity (m/s), z = enabled
} pc;

shared float sErr[256];

vec3 grad(uint k, uint i)
{
    uint o  = k * P.numFluid + i;
    uint KN = P.maxNeighbors * P.numFluid;
    return vec3(nbrGrad[o], nbrGrad[KN + o], nbrGrad[2u * KN + o]);
}
vec3 boundaryVel(uint j)    // j >= numFluid: static wall (0) or piston
{
    return (j >= P.numFluid + P.numBoundary) ? vec3(pc.piston.y, 0.0, 0.0) : vec3(0.0);
}

void main()
{
    uint i   = gl_GlobalInvocationID.x;
    uint lid = gl_LocalInvocationID.x;
    float err = 0.0;

    if (i < P.numFluid)
    {
        vec3  vi   = particles[i].vi.xyz;
        float invS = particles[i].vi.w;
        float rho  = particles[i].pd.w;
        uint  cnt  = meta[i].w;

        float delta = 0.0;              // d rho_i / dt / m
        for (uint k = 0u; k < cnt; ++k)
        {
            uint j = nbrIdx[k * P.numFluid + i];
            vec3 vj = (j < P.numFluid) ? particles[j].vi.xyz : boundaryVel(j);    // boundary particles are static
            delta += dot(vi - vj, grad(k, i));
        }
        delta *= P.mass;

        float s;
        if (pc.divergence != 0u)
        {
            err = max(delta, 0.0);
            if (meta[i].z < P.minNbrDiv)
                err = 0.0;              // particle deficiency (free surface): no divergence solve
            s = err * invS / pc.dt;
        }
        else
        {
            err = max(rho + pc.dt * delta - P.restDensity, 0.0);            // only compression is corrected
            s = err * invS / (pc.dt * pc.dt);
        }
        solS[i] = s;
    }

    // Work group reduction (deterministic tree)
    sErr[lid] = err;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u)
    {
        if (lid < stride)
            sErr[lid] += sErr[lid + stride];
        barrier();
    }
    if (lid == 0u)
        partials[gl_WorkGroupID.x] = sErr[0];
}
